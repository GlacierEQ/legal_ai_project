# Configuration pour l'authentification et les paiements

# Configuration JWT
JWT_SECRET_KEY=votre_cle_secrete_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuration Stripe
STRIPE_API_KEY=votre_cle_api_stripe
STRIPE_WEBHOOK_SECRET=votre_cle_secrete_webhook_stripe

# IDs des produits Stripe
STRIPE_FREEMIUM_PRICE_ID=price_freemium
STRIPE_STANDARD_PRICE_ID=price_standard
STRIPE_PRO_PRICE_ID=price_pro

# Configuration de la base de données
DATABASE_URL=sqlite:///./legal_assistant.db
# Pour PostgreSQL, utiliser le format suivant:
# DATABASE_URL=postgresql://user:password@localhost/legal_assistant
