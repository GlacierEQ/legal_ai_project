# Configuration pour Pinecone

# Identifiants pour Pinecone
PINECONE_API_KEY=votre_api_key_pinecone
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=legal-assistant

# Configuration du modèle d'embeddings
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# Configuration des paramètres d'indexation
CHUNK_SIZE=512
CHUNK_OVERLAP=128
BATCH_SIZE=100
