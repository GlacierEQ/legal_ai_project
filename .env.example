# Configuration pour l'API Légifrance

# Identifiants pour l'API Légifrance via PISTE
# Ces valeurs doivent être remplacées par vos identifiants réels obtenus après inscription sur https://piste.gouv.fr
LEGIFRANCE_CLIENT_ID=votre_client_id
LEGIFRANCE_CLIENT_SECRET=votre_client_secret

# Configuration des limites de requêtes
# Respecter les quotas définis par l'API pour éviter les blocages
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_DAY=10000

# Configuration du stockage
DATA_OUTPUT_DIR=/home/ubuntu/legal_ai_project/data/legifrance

# Configuration des logs
LOG_LEVEL=INFO
LOG_FILE=/home/ubuntu/legal_ai_project/logs/legifrance_collector.log
